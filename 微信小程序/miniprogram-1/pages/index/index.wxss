/**index.wxss**/

.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 添加标题样式 - 直接使用view元素替代伪元素 */
.container .page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #2c3e50;
  margin: 40rpx 0;
  text-align: center;
  width: 100%;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.data-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 40rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
  width: 90%;
  max-width: 700rpx;
  text-align: center;
  border: 1rpx solid #f0f0f0;
}

.data-card view {
  margin: 16rpx 0;
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.data-card view:last-child {
  border-bottom: none;
  color: #666;
  font-size: 28rpx;
  margin-top: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-style: italic;
  color: #7f8c8d;
}

.data-card view:first-child {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  border-bottom: 2rpx solid #3498db;
  padding-bottom: 20rpx;
}

.no-data {
  text-align: center;
  color: #999;
  margin: 60rpx 0;
  font-size: 32rpx;
  padding: 40rpx;
  background: #f9f9f9;
  border-radius: 20rpx;
  width: 90%;
  max-width: 700rpx;
}

/* 按钮样式优化 - 确保文字完全居中 */
button {
  width: 90%;
  max-width: 700rpx;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 34rpx;
  margin-top: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  transition: all 0.3s ease;
  /* 使用flex布局确保文字完全居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

button::after {
  border: none;
}

/* 加载数据按钮样式 - 使用更柔和的蓝色 */
button[type="primary"] {
  background: linear-gradient(135deg, #4fc3f7, #1976d2);
  color: white;
}

/* 停止加载按钮样式 - 红色背景，浅灰色文字 */
button[type="warn"] {
  background: linear-gradient(135deg, #f44336, #d32f2f);
  color: #f0f0f0; /* 浅灰色文字 */
}

/* 悬停效果 */
button:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.15);
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .data-card {
    width: 95%;
    padding: 30rpx 20rpx;
  }
  
  .data-card view {
    font-size: 30rpx;
  }
  
  .data-card view:first-child {
    font-size: 34rpx;
  }
  
  button {
    width: 95%;
  }
}

/* 添加加载动画效果 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.data-card, .no-data {
  animation: fadeIn 0.5s ease-out;
}

/* 按钮活动状态 */
button:active {
  transform: translateY(0);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}