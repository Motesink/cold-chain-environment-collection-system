/* 基础样式 */
.container {
  padding: 10rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

/* 紧凑的头部 - 调整布局 */
.compact-header {
  display: flex;
  align-items: center; /* 改为居中对齐，而不是拉伸 */
  padding: 10rpx 20rpx; /* 恢复内边距，给左右留空间 */
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 10rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  height: 70rpx; /* 固定高度，不要占满 */
  min-height: 70rpx; /* 最小高度也设置 */
}

.date-picker {
  flex: 1; /* 占据剩余空间 */
  padding: 12rpx 20rpx; /* 减小内边距 */
  background: rgba(255, 255, 255, 0.9);
  font-size: 26rpx; /* 字体稍微小一点 */
  color: #333;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50rpx; /* 固定高度 */
  line-height: 50rpx; /* 行高与高度相同，确保垂直居中 */
  border-radius: 6rpx; /* 添加圆角 */
  margin-right: 15rpx; /* 与刷新按钮之间添加间隔 */
}

.refresh-btn {
  width: 140rpx; /* 稍微减小宽度 */
  font-size: 26rpx;
  padding: 0;
  background: #07c160;
  color: white;
  border-radius: 6rpx; /* 恢复圆角 */
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx; /* 固定高度，与日期选择器相同 */
  border: none;
  text-align: center;
  line-height: 50rpx; /* 行高与高度相同，确保文字垂直居中 */
  margin-left: 250rpx; 
}

.refresh-btn.active {
  background: #fa5151;
}

.refresh-btn::after {
  border: none;
}

/* 紧凑的阈值设置 */
.compact-threshold {
  background: white;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  border: 1rpx solid #e0e0e0;
}

.threshold-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.threshold-label {
  width: 200rpx; /* 增加宽度，使标签更清晰 */
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
}

.threshold-input {
  flex: 1;
  padding: 12rpx 16rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 6rpx;
  font-size: 26rpx;
  text-align: center;
  height: 60rpx;
  line-height: 60rpx;
  background: #f9f9f9;
  transition: all 0.3s;
}

.threshold-input:focus {
  border-color: #07c160;
  background: white;
  box-shadow: 0 0 8rpx rgba(7, 193, 96, 0.2);
}

.threshold-separator {
  margin: 0 15rpx;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 应用按钮居中容器 */
.apply-btn-wrapper {
  display: flex;
  justify-content: center; /* 水平居中 */
  margin-top: 15rpx;
}

.apply-btn {
  width: 320rpx; /* 更长更宽的应用按钮 */
  height: 70rpx; /* 稍微降低高度 */
  font-size: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 10rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.apply-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.apply-btn::after {
  border: none;
}

/* 图表容器优化 */
.charts-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: white;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  border: 1rpx solid #e0e0e0;
  overflow: hidden;
}

.chart-wrapper {
  flex: 1;
  min-height: 0;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 15rpx;
}

.chart-wrapper:last-child {
  margin-bottom: 0;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 15rpx;
  text-align: center;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #eaeaea;
}

ec-canvas {
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
  border-radius: 6rpx;
}